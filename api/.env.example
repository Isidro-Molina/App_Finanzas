# ============================================================
# App Finanzas — API Environment Variables (EXAMPLE)
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL (Supabase) ────────────────────────────────────
# URL de connection pooling (PgBouncer) — usar en la app (puerto 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# URL de conexión directa — requerida por Prisma Migrate (puerto 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── JWT (para autenticación futura) ──────────────────────────
JWT_SECRET=change_me_to_a_very_long_random_secret
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8081
