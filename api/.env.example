# ============================================================
# App Finanzas — API Environment Variables (EXAMPLE)
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL (Supabase) ────────────────────────────────────
# URL de connection pooling (PgBouncer) — usar en la app (puerto 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# URL de conexión directa — requerida por Prisma Migrate (puerto 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── JWT ─────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32 (mínimo 32 caracteres, no usar valores por defecto)
JWT_SECRET=REEMPLAZAR_CON_SECRETO_HEX_DE_64_CARACTERES
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Google OAuth 2.0 ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ── Email (Nodemailer Gmail SMTP) ────────────────────────────
MAIL_USER=
MAIL_APP_PASSWORD=
