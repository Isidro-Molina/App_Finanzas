generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum TransactionType {
  INCOME
  EXPENSE
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

// ==========================================
// USUARIOS
// ==========================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   // Hash bcrypt — NUNCA exponer al cliente
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  personalTransactions Transaction[]
  categories           Category[]      // Categorías propias del usuario
  budgets              Budget[]
  groups               GroupMember[]
  groupsCreated        Group[]         @relation("GroupCreator") // Grupos que fundó
  expensesPaid         GroupExpense[]  @relation("PaidBy")
  splitsOwed           ExpenseSplit[]
}

// ==========================================
// MÓDULO 1: FINANZAS PERSONALES
// ==========================================

model Category {
  id   String          @id @default(uuid())
  name String          // Ej: "Supermercado", "Sueldo", "Salidas"
  icon String?         // Emoji o nombre de ícono (ej: "🛒", "💼")
  type TransactionType // ← Enum: INCOME o EXPENSE (antes era String libre)

  // null = categoría global (seeded para todos), userId = categoría personal
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(12, 2) // ← Decimal para cálculos exactos de dinero
  description String?
  type        TransactionType // Redundante con Category.type pero simplifica queries de balance
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
}

// Presupuesto mensual por categoría (ej: $50.000 en "Salidas" para Agosto 2025)
model Budget {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2) // Monto presupuestado
  month     Int      // 1 = Enero ... 12 = Diciembre
  year      Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Un solo presupuesto por usuario/categoría/mes/año
  @@unique([userId, categoryId, month, year])
}

// ==========================================
// MÓDULO 2: DIVISOR DE GASTOS (ESTILO SPLITWISE)
// ==========================================

model Group {
  id        String   @id @default(uuid())
  name      String   // Ej: "Asado Finde", "Viaje a Mendoza"
  isSettled Boolean  @default(false) // true = grupo saldado/cerrado
  createdAt DateTime @default(now())

  createdById String
  createdBy   User   @relation("GroupCreator", fields: [createdById], references: [id])

  members  GroupMember[]
  expenses GroupExpense[]
}

// Relación Muchos-a-Muchos entre Usuarios y Grupos
model GroupMember {
  userId   String
  groupId  String
  role     GroupMemberRole @default(MEMBER) // ← ADMIN puede cerrar el grupo, borrar gastos
  joinedAt DateTime        @default(now())  // ← Para saber cuándo se unió

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@id([userId, groupId]) // Clave primaria compuesta
}

// El ticket o recibo general (Ej: Juan pagó $10.000 de asado)
model GroupExpense {
  id          String   @id @default(uuid())
  description String   // Ej: "Carnicería"
  amount      Decimal  @db.Decimal(12, 2) // ← Decimal
  date        DateTime @default(now())

  groupId  String
  group    Group  @relation(fields: [groupId], references: [id])

  paidById String
  paidBy   User   @relation("PaidBy", fields: [paidById], references: [id])

  splits ExpenseSplit[]
}

// Cómo se divide ese ticket (Ej: Pedro debe $2.500, María debe $2.500)
model ExpenseSplit {
  id         String  @id @default(uuid())
  amountOwed Decimal @db.Decimal(12, 2) // ← Decimal
  isPaid     Boolean @default(false)    // ← Para marcar pagos individuales dentro del grupo

  groupExpenseId String
  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
}